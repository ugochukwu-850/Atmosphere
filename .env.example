# Base URL of the ArtMostSphere backend API (no trailing slash)
NEXT_PUBLIC_API_URL=https://api-production-ae3ac.up.railway.app

# Map tiles (optional). Defaults to OpenStreetMap; use a keyed provider in production.
# NEXT_PUBLIC_MAP_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
